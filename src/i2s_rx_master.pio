.program i2s_rx_master
.side_set 2

; side bit 1 = WS
; side bit 0 = SCK
;
; 0b00 -> WS=0, SCK=0
; 0b01 -> WS=0, SCK=1
; 0b10 -> WS=1, SCK=0
; 0b11 -> WS=1, SCK=1
;
; MSM261S4030H0R, L/R = 0:
; - valid audio only in left half-frame
; - 24-bit payload in a 32-bit slot
; - MSB delayed by 1 SCK from start of half-frame
; - right half-frame is not valid mic data

public entry_point:
.wrap_target

    ; --------------------------
    ; LEFT HALF-FRAME (WS = 0)
    ; --------------------------

    ; 1-bit I2S delay before MSB
    nop               side 0b01
    nop               side 0b01
    nop               side 0b00

    ; receive 24 valid bits
    set x, 23         side 0b00

left_bits:
    nop               side 0b01
    in pins, 1        side 0b01
    jmp x-- left_bits side 0b00

    ; remaining 7 clocks in left 32-bit slot after 24-bit word
    set x, 6          side 0b00

left_pad:
    nop               side 0b01
    nop               side 0b01
    jmp x-- left_pad  side 0b00

    ; --------------------------
    ; RIGHT HALF-FRAME (WS = 1)
    ; mic is tri-stated here when L/R = 0
    ; still generate all 32 clocks
    ; --------------------------

    set x, 31         side 0b10

right_idle:
    nop               side 0b11
    nop               side 0b11
    jmp x-- right_idle side 0b10

.wrap